# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — SERVER ONLY, never exposed to the browser. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────────
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard > Developers > Webhooks (or from `stripe listen` in dev)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Gelato ────────────────────────────────────────────────────────────────
# API Portal: https://dashboard.gelato.com > API keys
# SERVER ONLY. This key can create/manage orders — never expose it client-side.
GELATO_API_KEY=
# Optional: shipping method alias/uid ("express" | "normal" | specific uid).
# Default "express" — verified cheaper AND faster to IL than "normal".
GELATO_SHIPMENT_METHOD=express

# ── Admin ─────────────────────────────────────────────────────────────────
# Password to log into /admin
ADMIN_PASSWORD=change-me
# Random long string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.com

# ── Misc ──────────────────────────────────────────────────────────────────
# WhatsApp floating button + contact page, international format, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=9725xxxxxxx
NEXT_PUBLIC_CONTACT_EMAIL=info@yourdomain.com
